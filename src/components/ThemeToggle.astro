---
// Hidden without JavaScript; ThemeScript adds the `js` class that reveals it and handles the click.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={label} title={label}>
  <!-- Lucide "sun-moon" -->
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"></path>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.9 4.9 1.4 1.4"></path>
    <path d="m17.7 17.7 1.4 1.4"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.3 17.7-1.4 1.4"></path>
    <path d="m19.1 4.9-1.4 1.4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  :global(html.js) .theme-toggle {
    display: inline-grid;
  }

  .theme-toggle:hover {
    background: var(--surface-2);
    border-color: var(--accent-text);
  }
</style>
