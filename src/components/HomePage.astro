---
// Home shared by both languages. More bento cells arrive in specs 003–005; their anchors exist already.
import ButtonLink from "./ButtonLink.astro";
import Cell from "./bento/Cell.astro";
import { links } from "../content/links.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHome, getUi, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const home = getHome(locale);
---

<BaseLayout locale={locale} alternates={{ en: "/", es: "/es/" }}>
  <main id="main">
    <div class="bento">
      <Cell area="hero" label={home.hero.label}>
        <h1>{ui.site.name}</h1>
        <!-- The full hero cell arrives in T4. -->
        <div class="ctas">
          <ButtonLink href={`#${ui.anchors.projects}`} variant="primary" icon="arrow-down">{home.hero.cta.work}</ButtonLink>
          <ButtonLink href={home.hero.cvFile} icon="download" download>{home.hero.cta.cv}</ButtonLink>
          <ButtonLink href={links.calCom} icon="calendar" external newTabLabel={ui.a11y.newTab}>{home.hero.cta.call}</ButtonLink>
        </div>
      </Cell>
      <Cell area="photo" label={home.photo.label} />
    </div>
    <section id={ui.anchors.projects}></section>
    <section id={ui.anchors.experience}></section>
    <section id={ui.anchors.contact}></section>
  </main>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-10) var(--margin) var(--space-12);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas: "hero hero photo photo";
    gap: var(--gutter);
  }

  @media (max-width: 1023px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hero hero"
        "photo photo";
    }
  }

  @media (max-width: 639px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "hero"
        "photo";
    }

    main {
      padding-top: var(--space-6);
    }
  }
</style>
