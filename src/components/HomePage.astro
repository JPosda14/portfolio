---
// Home shared by both languages. More bento cells arrive in specs 004–005; their anchors exist already.
import ProfileSection from "./ProfileSection.astro";
import ProjectsSection from "./ProjectsSection.astro";
import HeroCell from "./bento/HeroCell.astro";
import PhotoCell from "./bento/PhotoCell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getUi, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<BaseLayout locale={locale} alternates={{ en: "/", es: "/es/" }}>
  <main id="main">
    <div class="bento">
      <HeroCell locale={locale} />
      <PhotoCell locale={locale} />
    </div>
    <ProjectsSection locale={locale} />
    <ProfileSection locale={locale} />
    <section id={ui.anchors.contact}></section>
  </main>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-10) var(--margin) var(--space-12);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas: "hero hero photo photo";
    gap: var(--gutter);
  }

  @media (max-width: 1023px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hero hero"
        "photo photo";
    }
  }

  @media (max-width: 639px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "hero"
        "photo";
    }

    main {
      padding-top: var(--space-6);
    }
  }
</style>
