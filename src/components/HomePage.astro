---
// Home shared by both languages: hero bento, projects, profile (experience, thinking, skills) and contact.
import ProfileSection from "./ProfileSection.astro";
import ProjectsSection from "./ProjectsSection.astro";
import ContactCell from "./bento/ContactCell.astro";
import HeroCell from "./bento/HeroCell.astro";
import NowCell from "./bento/NowCell.astro";
import PhotoCell from "./bento/PhotoCell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHome, type Locale } from "../i18n/index.ts";
import { isNowFresh } from "../lib/now.ts";
import { personJsonLd } from "../lib/seo.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Static site: "Now" is checked when the site is built, so it disappears on the first build after 90 days.
const showNow = isNowFresh(getHome(locale).now.updated, new Date());
const person = personJsonLd(locale, (Astro.site ?? new URL("https://juanposada.dev")).href);
---

<BaseLayout locale={locale} alternates={{ en: "/", es: "/es/" }} jsonLd={person}>
  <main id="main">
    <div class:list={["bento", { "has-now": showNow }]}>
      <HeroCell locale={locale} />
      <PhotoCell locale={locale} />
      {showNow && <NowCell locale={locale} />}
    </div>
    <ProjectsSection locale={locale} />
    <ProfileSection locale={locale} />
    <div class="closing">
      <ContactCell locale={locale} />
    </div>
  </main>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-10) var(--margin) var(--space-12);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas: "hero hero photo photo";
    gap: var(--gutter);
  }

  .bento.has-now {
    grid-template-areas:
      "hero hero photo photo"
      "hero hero now now";
  }

  .closing {
    display: grid;
    grid-template-areas: "contact";
    margin-top: var(--gutter);
  }

  @media (max-width: 1023px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hero hero"
        "photo photo";
    }

    .bento.has-now {
      grid-template-areas:
        "hero hero"
        "photo now";
    }
  }

  @media (max-width: 639px) {
    .bento,
    .bento.has-now {
      grid-template-columns: minmax(0, 1fr);
    }

    .bento {
      grid-template-areas:
        "hero"
        "photo";
    }

    .bento.has-now {
      grid-template-areas:
        "hero"
        "photo"
        "now";
    }

    main {
      padding-top: var(--space-6);
    }
  }
</style>
