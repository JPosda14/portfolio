---
// Lucide line icon as inline SVG, so no icon font or JS is shipped.
import { lineIcons, type LineIconName } from "../lib/icons.ts";

export type IconName = LineIconName;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={lineIcons[name].join("")}
/>
