---
// Experience and skills: the part of the bento after the projects. Its own grid, same columns and gap.
import ExperienceCell from "./bento/ExperienceCell.astro";
import SkillsCell from "./bento/SkillsCell.astro";
import { getHome, getUi, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const { skills } = getHome(locale);
---

<section class="profile" aria-labelledby="profile-heading">
  <h2 id="profile-heading" class="visually-hidden">{ui.profile.heading}</h2>
  <ExperienceCell locale={locale} />
  <SkillsCell area="daily" label={skills.daily.label} items={skills.daily.items} footer={{ label: skills.alsoLabel, text: skills.also }} />
  <SkillsCell area="learn" label={skills.learning.label} items={skills.learning.items} />
  <SkillsCell area="biz" label={skills.business.label} items={skills.business.items} accent />
</section>

<style>
  .profile {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      "exp exp daily daily"
      "learn learn biz biz";
    gap: var(--gutter);
    margin-top: var(--gutter);
  }

  @media (max-width: 1023px) {
    .profile {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "exp exp"
        "daily daily"
        "learn biz";
    }
  }

  @media (max-width: 639px) {
    .profile {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "exp" "daily" "learn" "biz";
    }
  }
</style>
