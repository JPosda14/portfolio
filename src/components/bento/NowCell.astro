---
// "Now": what Juan is doing these days, with its date. HomePage hides it when the date is too old.
import Text from "../Text.astro";
import Cell from "./Cell.astro";
import { getHome, type Locale } from "../../i18n/index.ts";
import { formatMonth } from "../../lib/dates.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { now } = getHome(locale);
---

<Cell area="now" label={now.label}>
  <p class="text"><Text value={now.text} /></p>
  <p class="updated">
    <Text value={now.updatedLabel} />
    <time datetime={now.updated}>{formatMonth(now.updated, locale)}</time>
  </p>
</Cell>

<style>
  .text {
    font: 400 var(--text-role) / 1.35 var(--font-display);
  }

  .updated {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
    font: 500 var(--text-label) / 1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  time {
    color: var(--accent-text);
  }
</style>
