    "test": "playwright test",
    "lhci": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1"
  }
}
