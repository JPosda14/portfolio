{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio of Juan Andrés Posada — Astro, bilingual EN/ES, built with Spec-Driven Development",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
